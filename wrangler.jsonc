{
  "name": "blush-apples",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "containers": [
    { "class_name": "ApiContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "ApiContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  // keeps the container warm and sends appointment reminders every 15 minutes
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "NODE_ENV": "production", "STORAGE_PROVIDER": "cloudinary", "TRUST_PROXY": "1" }
}
