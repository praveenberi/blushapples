# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Public URL of the website (used in emails, sitemap, CORS in dev)
PUBLIC_URL=http://localhost:5173
# REQUIRED in production: 32+ random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# ---------- Database ----------
# Leave empty in development to use embedded PGlite (real Postgres, stored in server/data/pglite).
# Set for production, e.g. postgres://user:pass@host:5432/blushapples
DATABASE_URL=

# ---------- First admin account (created on first start only) ----------
ADMIN_EMAIL=admin@example.com
# If empty, a strong random password is generated and printed ONCE in the server log.
ADMIN_PASSWORD=

# ---------- Image storage ----------
# local (dev only; files in server/uploads) | cloudinary (use this in production)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blush-apples

# ---------- AI photo enhancement (optional) ----------
# none | http. Manual editing tools always work without it.
AI_PROVIDER=none
# Endpoint that accepts {image: base64, options} and returns an image or {image: base64}
AI_PROVIDER_URL=
AI_PROVIDER_KEY=

# ---------- Email (optional; without it notifications are logged as "skipped") ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Blush & Apples <no-reply@yourdomain.com>"

# ---------- WhatsApp Cloud API admin alerts (optional; click-to-chat works without it) ----------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
