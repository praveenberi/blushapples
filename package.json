{
  "name": "blush-apples",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@cloudflare/containers": "^0.0.13",
    "wrangler": "^4.20.0"
  }
}
